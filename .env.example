# --- LLM (Gemini free tier, via its OpenAI-compatible endpoint) ---
GEMINI_API_KEY=your-key-here          # GOOGLE_API_KEY also works
# Use the same model string that worked in your course code (Module 2)
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Oracle AI Database 23ai Free (docker compose up -d) ---
ORACLE_USER=vector_user
ORACLE_PASSWORD=VectorPass_123
ORACLE_SYS_PASSWORD=SysPass_123
ORACLE_DSN=localhost:1521/FREEPDB1

# --- Agent behaviour ---
MAX_TURNS=10            # hard cap on agent loop iterations (runaway protection)
GUARDRAIL_LLM=1         # 1 = LLM scope check + regex, 0 = regex only (saves quota)
GUARDRAIL_FAIL_CLOSED=1 # block if the scope checker itself fails
LLM_MAX_RETRIES=6       # exponential backoff on 429s from the free tier
EVAL_DELAY_SECONDS=8    # pause between eval questions (free-tier RPM)
